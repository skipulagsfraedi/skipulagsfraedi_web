---
import {getNavigationItems, type NavigationItem} from '../lib/navigation';
import {getPageTree} from '../lib/pages';

const {items} = Astro.props as {
  items?: NavigationItem[];
};

let navItems: NavigationItem[];

if (items) {
  navItems = items;
} else {
  const navPages = await getPageTree();
  navItems = getNavigationItems(navPages);
}

const desktopLinkClass =
  'transition-colors hover:text-[#4d5c55] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#4d5c55] focus-visible:ring-offset-2 focus-visible:ring-offset-white';
const submenuLinkClass =
  'block rounded-md px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-zinc-100 hover:text-[#4d5c55] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#4d5c55] focus-visible:ring-offset-2 focus-visible:ring-offset-white';
const mobileLinkClass = submenuLinkClass;
const mobileChildLinkClass = `${submenuLinkClass} pl-6`;

const desktopDropdownClass =
  'absolute left-0 top-full -mt-1 pt-1 min-w-[12rem] rounded-lg border border-zinc-200 bg-white p-2 text-sm text-slate-600 opacity-0 shadow-lg transition duration-150 ease-out max-h-0 overflow-hidden translate-y-1';

const desktopDropdownActiveClass =
  'group-hover:opacity-100 group-hover:max-h-[24rem] group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:max-h-[24rem] group-focus-within:translate-y-0';

---

<div class="ml-auto flex flex-shrink-0 items-center gap-3">
  <nav aria-label="Aðal valmynd" class="hidden items-center gap-6 font-medium text-slate-500 md:flex">
    {navItems.map((item) => {
      const hasChildren = item.children && item.children.length > 0;
      return (
        <div class={`relative ${hasChildren ? 'group before:absolute before:inset-x-0 before:top-full before:h-2 before:content-[\'\']' : ''}`}>
          <a
            class={`${desktopLinkClass}${hasChildren ? ' inline-flex items-center gap-1' : ''}`}
            href={item.href}
            aria-haspopup={hasChildren ? 'true' : undefined}
            aria-expanded={hasChildren ? 'false' : undefined}
          >
            {item.label}
            {hasChildren && (
              <svg
                aria-hidden="true"
                class="h-3 w-3 text-current transition group-hover:-rotate-180 group-focus-within:-rotate-180"
                fill="none"
                viewBox="0 0 12 8"
              >
                <path d="M10.6667 1L6 5.66667L1.33333 1" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" />
              </svg>
            )}
          </a>
          {hasChildren && (
            <div class={`${desktopDropdownClass} ${desktopDropdownActiveClass}`} role="menu" aria-label={`${item.label} undirvalmynd`}>
              <div class="space-y-1 py-1">
                {item.children?.map((child) => (
                  <a class={submenuLinkClass} href={child.href} role="menuitem">
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      );
    })}
  </nav>

  <div class="relative md:hidden">
    <details class="group">
      <summary
        aria-label="Opna valmynd"
        class="flex cursor-pointer items-center gap-2 rounded-md border border-zinc-200 bg-white px-3 py-2 text-sm font-medium text-slate-600 shadow-sm transition hover:bg-zinc-100 hover:text-[#4d5c55] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#4d5c55] focus-visible:ring-offset-2 focus-visible:ring-offset-white [&::-webkit-details-marker]:hidden"
      >
        Valmynd
        <svg aria-hidden="true" class="h-4 w-4 text-current transition group-open:rotate-180" fill="none" viewBox="0 0 12 8">
          <path d="M10.6667 1L6 5.66667L1.33333 1" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" />
        </svg>
      </summary>
      <nav
        aria-label="Farsíma valmynd"
        class="absolute right-0 z-10 mt-3 w-60 space-y-1 rounded-lg border border-zinc-200 bg-white p-2 text-sm text-slate-600 shadow-lg"
      >
        {navItems.map((item) => (
          <div>
            <a class={mobileLinkClass} href={item.href}>
              {item.label}
            </a>
            {item.children?.length ? (
              <div class="space-y-1">
                {item.children.map((child) => (
                  <a class={mobileChildLinkClass} href={child.href}>
                    {child.label}
                  </a>
                ))}
              </div>
            ) : null}
          </div>
        ))}
      </nav>
    </details>
  </div>
</div>
